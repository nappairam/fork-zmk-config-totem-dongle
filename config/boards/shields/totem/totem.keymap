// Miryoku ZMK - QWERTY + VI Nav + Default Layers
// Ported from miryoku macro system to standalone keymap for Totem (38 keys)
//
// Layer indices:
//   0=BASE  1=EXTRA  2=TAP  3=BUTTON  4=NAV  5=MOUSE  6=MEDIA  7=NUM  8=SYM  9=FUN

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE   0
#define EXTRA  1
#define TAP    2
#define BUTTON 3
#define NAV    4
#define MOUSE  5
#define MEDIA  6
#define NUM    7
#define SYM    8
#define FUN    9

&mmv {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <300>;
    delay-ms = <0>;
};

/ {
    behaviors {
        u_mt: u_mt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        u_lt: u_lt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };

        u_BASE: u_BASE {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&none>, <&to BASE>;
        };

        u_EXTRA: u_EXTRA {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&none>, <&to EXTRA>;
        };

        u_TAP: u_TAP {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&none>, <&to TAP>;
        };

        u_NAV: u_NAV {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&none>, <&to NAV>;
        };

        u_MOUSE: u_MOUSE {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&none>, <&to MOUSE>;
        };

        u_MEDIA: u_MEDIA {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&none>, <&to MEDIA>;
        };

        u_NUM: u_NUM {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&none>, <&to NUM>;
        };

        u_SYM: u_SYM {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&none>, <&to SYM>;
        };

        u_FUN: u_FUN {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&none>, <&to FUN>;
        };

        u_caps_word: u_caps_word {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&caps_word>, <&kp CAPS>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        u_out_tog: u_out_tog {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&out OUT_TOG>, <&out OUT_USB>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
                &kp Q            &kp W            &kp E            &kp R            &kp T              &kp Y            &kp U            &kp I            &kp O            &kp P
                &u_mt LGUI A     &u_mt LALT S     &u_mt LCTRL D    &u_mt LSHFT F    &kp G              &kp H            &u_mt LSHFT J    &u_mt LCTRL K    &u_mt LALT L     &u_mt LGUI SQT
    &kp Q       &u_lt BUTTON Z   &u_mt RALT X     &kp C            &kp V            &kp B              &kp N            &kp M            &kp COMMA        &u_mt RALT DOT   &u_lt BUTTON SLASH  &kp P
                                 &u_lt MEDIA ESC  &u_lt NAV SPACE  &u_lt MOUSE TAB                     &u_lt SYM RET    &u_lt NUM BSPC   &u_lt FUN DEL
            >;
        };

        extra_layer {
            display-name = "Extra";
            bindings = <
                &kp Q            &kp W            &kp E            &kp R            &kp T              &kp Y            &kp U            &kp I            &kp O            &kp P
                &u_mt LGUI A     &u_mt LALT S     &u_mt LCTRL D    &u_mt LSHFT F    &kp G              &kp H            &u_mt LSHFT J    &u_mt LCTRL K    &u_mt LALT L     &u_mt LGUI SQT
    &kp Q       &u_lt BUTTON Z   &u_mt RALT X     &kp C            &kp V            &kp B              &kp N            &kp M            &kp COMMA        &u_mt RALT DOT   &u_lt BUTTON SLASH  &kp P
                                 &u_lt MEDIA ESC  &u_lt NAV SPACE  &u_lt MOUSE TAB                     &u_lt SYM RET    &u_lt NUM BSPC   &u_lt FUN DEL
            >;
        };

        tap_layer {
            display-name = "Tap";
            bindings = <
                &kp Q            &kp W            &kp F            &kp P            &kp B              &kp J            &kp L            &kp U            &kp Y            &kp SQT
                &kp A            &kp R            &kp S            &kp T            &kp G              &kp M            &kp N            &kp E            &kp I            &kp O
    &kp Q       &kp Z            &kp X            &kp C            &kp D            &kp V              &kp K            &kp H            &kp COMMA        &kp DOT          &kp SLASH           &kp SQT
                                 &kp ESC          &kp SPACE        &kp TAB                             &kp RET          &kp BSPC         &kp DEL
            >;
        };

        button_layer {
            display-name = "Button";
            bindings = <
                &kp K_UNDO       &kp LS(DEL)      &kp LC(INS)      &kp LS(INS)      &kp K_AGAIN        &kp K_AGAIN      &kp LS(INS)      &kp LC(INS)      &kp LS(DEL)      &kp K_UNDO
                &kp LGUI         &kp LALT         &kp LCTRL        &kp LSHFT        &none              &none            &kp LSHFT        &kp LCTRL        &kp LALT         &kp LGUI
    &kp K_UNDO  &kp K_UNDO       &kp LS(DEL)      &kp LC(INS)      &kp LS(INS)      &kp K_AGAIN        &kp K_AGAIN      &kp LS(INS)      &kp LC(INS)      &kp LS(DEL)      &kp K_UNDO          &kp K_UNDO
                                 &mkp MB3         &mkp MB1         &mkp MB2                            &mkp MB2         &mkp MB1         &mkp MB3
            >;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
                &bootloader      &u_TAP           &u_EXTRA         &u_BASE          &none              &kp K_AGAIN      &kp LS(INS)      &kp LC(INS)      &kp LS(DEL)      &kp K_UNDO
                &kp LGUI         &kp LALT         &kp LCTRL        &kp LSHFT        &none              &kp LEFT         &kp DOWN         &kp UP           &kp RIGHT        &u_caps_word
    &bootloader &none            &kp RALT         &u_NUM           &u_NAV           &none              &kp HOME         &kp PG_DN        &kp PG_UP        &kp END          &kp INS             &kp K_UNDO
                                 &none            &none            &none                               &kp RET          &kp BSPC         &kp DEL
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
                &bootloader      &u_TAP           &u_EXTRA         &u_BASE          &none              &kp K_AGAIN      &kp LS(INS)      &kp LC(INS)      &kp LS(DEL)      &kp K_UNDO
                &kp LGUI         &kp LALT         &kp LCTRL        &kp LSHFT        &none              &mmv MOVE_LEFT   &mmv MOVE_DOWN   &mmv MOVE_UP     &mmv MOVE_RIGHT  &none
    &bootloader &none            &kp RALT         &u_SYM           &u_MOUSE         &none              &msc SCRL_LEFT   &msc SCRL_DOWN   &msc SCRL_UP     &msc SCRL_RIGHT  &none               &kp K_UNDO
                                 &none            &none            &none                               &mkp MB2         &mkp MB1         &mkp MB3
            >;
        };

        media_layer {
            display-name = "Media";
            bindings = <
                &bootloader      &u_TAP           &u_EXTRA         &u_BASE          &none              &none            &none            &none            &none            &none
                &kp LGUI         &kp LALT         &kp LCTRL        &kp LSHFT        &none              &kp C_PREV       &kp C_VOL_DN     &kp C_VOL_UP     &kp C_NEXT       &none
    &bootloader &none            &kp RALT         &u_FUN           &u_MEDIA         &none              &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &u_out_tog          &studio_unlock
                                 &none            &none            &none                               &kp C_STOP       &kp C_PP         &kp C_MUTE
            >;
        };

        num_layer {
            display-name = "Num";
            bindings = <
                &kp LBKT         &kp N7           &kp N8           &kp N9           &kp RBKT           &none            &u_BASE          &u_EXTRA         &u_TAP           &bootloader
                &kp SEMI         &kp N4           &kp N5           &kp N6           &kp EQUAL          &none            &kp LSHFT        &kp LCTRL        &kp LALT         &kp LGUI
    &kp LBKT    &kp GRAVE        &kp N1           &kp N2           &kp N3           &kp BSLH           &none            &u_NUM           &u_NAV           &kp RALT         &none               &bootloader
                                 &kp DOT          &kp N0           &kp MINUS                           &none            &none            &none
            >;
        };

        sym_layer {
            display-name = "Sym";
            bindings = <
                &kp LBRC         &kp AMPS         &kp ASTRK        &kp LPAR         &kp RBRC           &none            &u_BASE          &u_EXTRA         &u_TAP           &bootloader
                &kp COLON        &kp DLLR         &kp PRCNT        &kp CARET        &kp PLUS           &none            &kp LSHFT        &kp LCTRL        &kp LALT         &kp LGUI
    &kp LBRC    &kp TILDE        &kp EXCL         &kp AT           &kp HASH         &kp PIPE           &none            &u_SYM           &u_MOUSE         &kp RALT         &none               &bootloader
                                 &kp LPAR         &kp RPAR         &kp UNDER                           &none            &none            &none
            >;
        };

        fun_layer {
            display-name = "Fun";
            bindings = <
                &kp F12          &kp F7           &kp F8           &kp F9           &kp PSCRN          &none            &u_BASE          &u_EXTRA         &u_TAP           &bootloader
                &kp F11          &kp F4           &kp F5           &kp F6           &kp SLCK           &none            &kp LSHFT        &kp LCTRL        &kp LALT         &kp LGUI
    &kp F12     &kp F10          &kp F1           &kp F2           &kp F3           &kp PAUSE_BREAK    &none            &u_FUN           &u_MEDIA         &kp RALT         &none               &bootloader
                                 &kp K_APP        &kp SPACE        &kp TAB                             &none            &none            &none
            >;
        };
    };
};
